# Kavach Pay API configuration. Copy to .env.local for local runs; on Render set these in the dashboard.

# Postgres (Neon pooled URL, or the local container: postgresql://kavach:kavach@localhost:5433/kavach_dev)
DATABASE_URL=

# Browser origins allowed to call the API, comma-separated (the frontend URL(s)).
FRONTEND_ORIGINS=http://localhost:3000

# Clerk: the secret key verifies session tokens. Required unless AUTH_DISABLED=1.
CLERK_SECRET_KEY=

# Signs demo-trial sessions. If empty, one is derived from CLERK_SECRET_KEY.
DEMO_SESSION_SECRET=

# Gemini. Leave empty for rules-only mode.
GEMINI_API_KEY=

PORT=4000
# Apply database migrations on start (1) or not (0).
MIGRATE_ON_START=1

# Database the automated tests may wipe (local Docker Postgres).
TEST_DATABASE_URL=postgresql://kavach:kavach@localhost:5433/kavach_test

# Optional
# GEMINI_MODEL_LIVE=gemini-3.5-flash-lite
# GEMINI_MODEL_COPILOT=gemini-3.8-flash
# AI_TIMEOUT_MS=4000
# AI_CACHE=1         # replay cached Gemini results (labelled "cached")
# AI_DISABLED=1      # force rules-only mode
# AUTH_DISABLED=1    # sign-in off: tests only, never in production
