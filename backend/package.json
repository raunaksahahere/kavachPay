{
  "name": "kavach-pay-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kavach Pay API: payment rail, risk engine, Gemini layer and audit log.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "esbuild src/server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "eval:rules": "tsx scripts/eval-rules.ts",
    "eval:ai": "tsx scripts/eval-ai.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.29.0",
    "@google/genai": "^3.3.0",
    "@hono/node-server": "^2.1.7",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
