# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string for the app (Neon pooled URL, or the local container).
# Neon:  postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Local: postgresql://kavach:kavach@localhost:5433/kavach_test
DATABASE_URL=

# Postgres used by the automated tests. Tests TRUNCATE tables, so never point
# this at the database that holds your demo data. Defaults to the local container.
TEST_DATABASE_URL=postgresql://kavach:kavach@localhost:5433/kavach_test

# Gemini API key from Google AI Studio. Leave empty to run in rules-only mode.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL_LIVE=gemini-3.5-flash-lite
# GEMINI_MODEL_COPILOT=gemini-3.8-flash
# AI_TIMEOUT_MS=4000
# AI_DISABLED=1          # force rules-only mode even when a key is present
# AI_CACHE=1             # replay cached Gemini results for identical inputs (demo mode)
