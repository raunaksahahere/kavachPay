# Kavach Pay frontend. Copy to .env.local.

# Where the backend API runs (backend/). /api/* is forwarded there.
BACKEND_URL=http://localhost:4000

# Clerk (same Clerk application as the backend).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AUTH_DISABLED=1   # sign-in off: automated tests only (the backend must match)
